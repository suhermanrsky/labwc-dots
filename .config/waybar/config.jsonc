  /////////////////////////////////
  //                             //
  //  // Waybar configuration//  //
  //                             //
  /////////////////////////////////

  {
      "layer": "top",
      "position": "top",
      "height": 38,
      "spacing": 0,
      "margin-top": 0,
      "margin-bottom": 0,
      "reload_style_on_change": true,
      "passthrough": false,

      /////////////////////////////////////////////
      //                                         //
      //  // Choose the order of the modules //  //
      //                                         //
      /////////////////////////////////////////////

      "modules-left": ["custom/launcher", "custom/chrome", "custom/terminal",
			 "custom/gallery", "custom/thunar", "wlr/taskbar"],

      "modules-center": [],

      "modules-right": ["keyboard-state", "group/group-timer", "group/group-memory", "group/group-tools","tray", "custom/notification",
       "group/group-volume", "backlight", "group/group-network", "battery", "custom/clock", "custom/power"],



      //// Waybar Modules Configuration

      "wlr/taskbar":
      {
          "format": "{icon}",
          "icon-size": 22,
          "icon-theme": "Reversal-black-dark",
          "tooltip-format": "{title:.50}",
          "on-click": "minimize-raise",
          "on-click-middle": "close",
          "on-click-right": "fullscreen"
      },

      "keyboard-state":
      {
          "capslock": true,
          "format": "{icon}",
          "format-icons":
          {
              "locked": " Caps ",
              "unlocked": ""
          }
      },

      "idle_inhibitor":
      {
          "format": "{icon}",
          "format-icons":
          {
              "activated": "",
              "deactivated": ""
          }
      },

      "tray":
      {
          "icon-size": 20,
          "spacing": 10,
          "show-passive-items": true
      },

      "custom/clock":
      {
          "exec": "~/.config/waybar/scripts/clock_calendar/clock_calendar.sh",
          "return-type": "json",
          "format": "  {}",
          "format-alt": "  {alt}",
          "interval": 10,
          "tooltip": true,
          "on-click-right": "killall rofi || bash ~/.config/waybar/scripts/clock_calendar/choose.sh",
          "on-scroll-up": "$HOME/.config/waybar/scripts/clock_calendar/clock_calendar.sh --scroll-up",
          "on-scroll-down": "$HOME/.config/waybar/scripts/clock_calendar/clock_calendar.sh --scroll-down"
      },

      "backlight":
      {
          "device": "acpi_video0",
          "tooltip": true,
          "tooltip-format": "{percent}%\nNightlight",
          "format": "<big>{icon}</big> {percent}% ",
          "format-icons": ["󰃞 ", "󰃝 ", "󰃟 ", "󰃠 "],
          "on-scroll-up": "bash ~/.config/waybar/scripts/brightness_ctrl.sh 1+",
          "on-scroll-down": "bash ~/.config/waybar/scripts/brightness_ctrl.sh 1-",
          "on-click": "killall rofi || bash ~/.config/rofi/nightlight/night-light.sh"
      },

    "group/group-backlight": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "transition-left-to-right": true,
            "reveal-delay": 450
        },
        "modules" : [
            "backlight", 
            "backlight/slider"
        ]
    },

      "pulseaudio":
      {
          "format": "<big>{icon}</big> {volume}%",
          "tooltip": true,
          "tooltip-format": "{volume}%\nNowplaying",
          "format-bluetooth": "{volume}% {icon}",
          "format-bluetooth-muted": "{icon} {format_source}",
          "format-muted": " {format_source}",
          "format-source": "",
          "format-source-muted": "",
          "format-icons":
          {
              "headphone": "",
              "hands-free": "",
              "headset": "",
              "phone": "",
              "portable": "",
              "car": "",
              "default": ["󰕿", "󰖀", "󰕾"]
          },
          "on-click": "killall rofi || bash ~/.config/rofi/nowplaying/nowplaying.sh 2>/dev/null",
          "on-click-right": "bash ~/.config/waybar/scripts/volume_notif.sh --toggle-mute 2>/dev/null",
          "on-click-middle": "pavucontrol",
          "on-scroll-up": "bash ~/.config/waybar/scripts/volume_notif.sh up",
          "on-scroll-down": "bash ~/.config/waybar/scripts/volume_notif.sh down"
      },

    "group/group-volume": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "transition-left-to-right": true,
            "reveal-delay": 450
        },
        "modules" : [
            "pulseaudio", 
            "pulseaudio/slider"
        ]
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "on-update": "bash ~/.config/waybar/scripts/volume_notif.sh {value}"
    },

      "temperature#cpu": {
          "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
          "critical-threshold": 75,
          "format-critical": " {temperatureC}°C",
          "format": " {temperatureC}°C",
          "interval": 2
      },

      "group/group-memory":
      {
          "orientation": "inherit",
          "drawer":
          {
              "transition-duration": 500,
              "children-class": "memory-module",
              "transition-left-to-right": false
          },
          "modules": [
              "temperature#cpu",
              "power-profiles-daemon",
              "memory"
          ]
      },

      "memory":
      {
          "interval": 30,
          "format": "<big>󰍛</big>\u00a0\u00a0{percentage}%",
          "tooltip-format": "Memory: {used:0.1f}G/{total:0.1f}G\nPercentage: {percentage}% used\nAvailable: {avail}G\nSwap: {swapUsed:0.1f}G/{swapTotal:0.1f}G",
          "on-click": "xfce4-taskmanager"
      },
      
      "power-profiles-daemon": {
          "format": "{icon}",
          "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
          "tooltip": true,
          "format-icons": {
              "performance": "",
              "balanced": "",
              "power-saver": ""
          }
      },
      
    "battery": {
      "bat": "BAT0",
      "interval": 60,
      "states": {
        "warning": 30,
        "critical": 10
      },
      "format": " {icon} {capacity}%",
      "format-icons": ["", "", "", "", ""],
      "tooltip-format": "{timeTo}\nPower: {power} W\nHealth: {health}%\nCycles: {cycles}",
      "on-click-right": "bash ~/.config/eww/System-Menu/launch"
    },

      "custom/vpn": {
          "interval": 2,
          "exec": "ip tuntap show | grep -q . && echo '󰌆' || (ip link show | grep -q 'wg' && echo '󰌆' || echo '')",
          "format": "<big>{}</big>",
          "tooltip": false,
          "on-click": "nm-connection-editor"
      },

      "group/group-network":
      {
          "orientation": "inherit",
          "drawer":
          {
              "transition-duration": 500,
              "children-class": "network-speed",
              "transition-left-to-right": false
          },
          "modules": [
              "network",
              "custom/vpn",
              "network#speed"
          ]
      },

      "network":
      {
          "format-wifi": "<big>{icon}</big> {signalStrength}%",
          "format-ethernet": "<big>󰲝</big>",
          "format-linked": "<big>󰲝</big>",
          "format-disconnected": "󱛅",
          "format-disabled": "󱚼",
          "tooltip-format": "{ifname} via {gwaddr}",
          "tooltip-format-wifi": "  {essid} ({signalStrength}%)\nIP: {ipaddr}\nFreq: {frequency}GHz",
          "tooltip-format-ethernet": "󰲝 {ifname}\nIP: {ipaddr}/{cidr}",
          "tooltip-format-disconnected": "Disconnected",
          "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
          "on-click": "killall rofi || bash ~/.config/rofi/wifi/wifi.sh",
          "on-click-right": "nm-connection-editor"
      },

      "network#speed": {
          "interval": 2,
          "format-wifi": "({essid}) {bandwidthDownBytes}  {bandwidthUpBytes} ",
          "format-ethernet": "   {ifname} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes} ",
          "format-linked": " No IP ({ifname})",
          "format-disconnected": "   Disconnected",
          "tooltip-format-disconnected": "No Connection",
          "tooltip-format-disabled": "Wi-Fi is OFF",
          "tooltip-format-wifi": "{essid} ({signalStrength}%)\n\nFreq: {frequency}GHz\n {bandwidthDownBytes}  {bandwidthUpBytes}",
          "tooltip-format-ethernet": "{ifname} (Connected)\n {bandwidthDownBytes}  {bandwidthUpBytes}",
          "on-click-right": "killall rofi || ~/.config/waybar/scripts/data_monitor/data_monitor.sh"
      },

      //// Custom Module 

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": true,
        "all-outputs": true,
        "ignore-hidden": false
    },

      "group/group-timer":
      {
          "orientation": "inherit",
          "drawer":
          {
              "transition-duration": 500,
              "children-class": "timer-countdown",
              "transition-left-to-right": false
          },
          "modules": [
              "custom/timer",
              "custom/countdown"
          ]
      },

      "custom/timer":
      {
          "exec": "python3 ~/.config/waybar/scripts/timer/waybar_timer.py --monitor",
          "return-type": "json",
          "format": "{}",
          "on-click": "killall rofi || python3 ~/.config/waybar/scripts/timer/waybar_timer.py --current toggle-pause",
          "on-click-right": "killall rofi || bash ~/.config/waybar/scripts/timer/time_input.sh",
          "on-click-middle": "python3 ~/.config/waybar/scripts/timer/waybar_timer.py --current reset",
          "on-scroll-up": "python3 ~/.config/waybar/scripts/timer/waybar_timer.py --toggle-view",
          "on-scroll-down": "python3 ~/.config/waybar/scripts/timer/waybar_timer.py --toggle-view"
      },

      "custom/countdown":
      {
          "exec": "~/.config/waybar/scripts/countdown/countdown.sh",
          "return-type": "json",
          "format": "{}",
          "interval": 1,
          "on-click-right": "killall rofi || bash ~/.config/waybar/scripts/countdown/countdown.sh --show-rofi",
          "on-scroll-up": "~/.config/waybar/scripts/countdown/countdown.sh --scroll-up",
          "on-scroll-down": "~/.config/waybar/scripts/countdown/countdown.sh --scroll-down"
      },

      "custom/data-monitor":
      {
          "exec": "python3 ~/.config/waybar/scripts/data_monitor/data_monitor.py",
          "return-type": "json",
          "on-click": "killall rofi",
          "on-click-right": "killall rofi || bash ~/.config/waybar/scripts/data_monitor/data_monitor.sh"
      },

      "custom/notification":
      {
          "tooltip": true,
          "format": "<big><b>{icon}</b></big>",
          "format-icons":
          {
              "notification": "󰅸",
              "none": "󰂜",
              "dnd-notification": "󰂠",
              "dnd-none": "󰪓",
              "inhibited-notification": "󰂛",
              "inhibited-none": "󰪑",
              "dnd-inhibited-notification": "󰂛",
              "dnd-inhibited-none": "󰪑"
          },
          "return-type": "json",
          "exec": "pgrep -x dunst > /dev/null && echo '{\"text\": \"\", \"alt\": \"none\"}'",
          "on-click": "dunstctl history-pop || notify-send 'Dunst' 'No old notifications'",
          "on-click-right": "dunstctl set-paused toggle",
          "interval": 2,
          "signal": 8,
          "escape": true
      },

      /////////////////////
      //// Apps section ///
      /////////////////////

      "custom/launcher":
      {
          "format": "<big>󰣛\u00a0</big>",
          "tooltip": true,
          "tooltip-format": "Menu\nRight click to customize",
          "on-click": "killall rofi 2>/dev/null || bash ~/.config/rofi/launchers/launcher.sh 2>/dev/null",
          "on-click-right": "killall rofi 2>/dev/null || bash ~/.config/waybar/scripts/customize.sh 2>/dev/null"
      },

      "custom/chrome":
      {
          "format": "",
          "tooltip": true,
          "tooltip-format": "Browser",
          "on-click": "librewolf",
          "on-click-right": "helium",
          "on-click-middle": "brave"
      },

      "custom/terminal":
      {
          "format": "",
          "tooltip": true,
          "tooltip-format": "Terminal",
          "on-click": "alacritty",
          "on-click-right": "foot"
      },

      "custom/gallery":
      {
          "format": "󰉔",
          "tooltip": true,
          "tooltip-format": "Gallery",
          "on-click": "loupe",
      },

      "custom/thunar":
      {
          "format": "",
          "tooltip": true,
          "tooltip-format": "File Manager",
          "on-click": "thunar"
      },

      //// Tools Section 

      "group/group-tools":
      {
          "orientation": "inherit",
          "drawer":
          {
              "transition-duration": 500,
              "children-class": "other-apps",
              "transition-left-to-right": false
          },
          "modules": [
              "custom/clip",
              "custom/snip",
              "idle_inhibitor",
              "custom/wallselect", 
              "custom/theme-switcher",
              "custom/emoji",
              "bluetooth" 
          ]
      },

      "custom/clip":
      {
          "format": "<big></big>",
          "tooltip": true,
          "tooltip-format": "Clipboard",
          "on-click": "killall rofi 2>/dev/null || bash ~/.config/rofi/clipboard/clipboard.sh 2>/dev/null"
      },

      "custom/emoji":
      {
          "format": "<big>󰞅</big>",
          "tooltip": true,
          "tooltip-format": "Emoji",
          "on-click": "killall rofi 2>/dev/null || bash ~/.config/rofi/emoji-picker/emoji-picker.sh 2>/dev/null"
      },

      "custom/wallselect":
      {
          "format": "<big>󰸉\u00a0</big>",
          "tooltip": true,
          "tooltip-format": "wallpapers",
          "tooltip-format": "wallpapers",
          "on-click": "bash ~/.config/rofi/wallselect/wallselect.sh 2>/dev/null",
       },

      "custom/theme-switcher":
      {
          "format": "<big>\u00a0</big>",
          "tooltip": true,
          "tooltip-format": "Light/Dark",
          "tooltip-format": "Light/Dark",
          "on-click": "bash ~/.config/waybar/scripts/global_color_scheme_changer.sh 2>/dev/null",
          "on-click-right": "bash ~/.config/waybar/scripts/waybar_customize.sh 2>/dev/null"
       },

      "bluetooth": {
          "format": "<big></big>",
          "format-connected": "<big>󰂱</big> {num_connections}",
          "format-disabled": "<big>󰂲</big>",
          "format-off": "<big>󰂲</big>",
          "tooltip-format": "{controller_alias} {status}",
          "tooltip-format-connected": "{num_connections} Connected:\n{device_enumerate}",
          "tooltip-format-enumerate-connected-battery": "{device_alias} (   {device_battery_percentage}%)",
          "on-click": "blueman-manager",
          "on-click-right": "rfkill toggle bluetooth"
      },

      "custom/snip":
      {
          "format": "",
          "tooltip": true,
          "tooltip-format": "Screenshot",
          "on-click": "killall rofi 2>/dev/null || bash ~/.config/rofi/screen-tool/screen-tool.sh 2>/dev/null"
      },

      "custom/power":
      {
          "format": "<big></big>",
          "tooltip": true,
          "tooltip-format": "Powermenu",
          "on-click": "killall rofi 2>/dev/null || bash ~/.config/rofi/powermenu/powermenu.sh 2>/dev/null"
      }
  }
