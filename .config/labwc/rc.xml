<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <maximizedDecoration>none</maximizedDecoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <autoEnableOutputs>yes</autoEnableOutputs>
    <reuseOutputMode>no</reuseOutputMode>
    <xwaylandPersistence>no</xwaylandPersistence>
    <primarySelection>yes</primarySelection>
  </core>
  <placement>
    <policy>cascade</policy>
    <!--"automatic" <cascadeOffset x="40" y="30" /> -->
  </placement>
  <dropShadows>no</dropShadows>
  <dropShadowsOnTiled>no</dropShadowsOnTiled>
  <!-- Theme -->
  <theme>
    <name>labPiXflat-xbm</name>
    <font name="SF Pro Display" size="10"/>
    <cornerRadius>0</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>no</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <icon>Reversal-black-dark</icon>
    <titlebar>
      <layout>:iconify,max,close</layout>
      <showTitle>no</showTitle>
    </titlebar>
  </theme>
  <!-- Hover to focous window -->
  <focus>
    <followMouse>yes</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <!-- Key bindings -->
  <!-- W is the Super key (windows), A is the Alt key, S is the Shift key -->
  <!-- s and S are different, s is a alphabetic character -->
  <keyboard>
    <default/>
    <!--AlwaysOnTop -->
    <keybind key="W-a">
      <action name="ToggleAlwaysOnTop"/>
    </keybind>
    <!--Magnifier -->
    <keybind key="W-m">
      <action name="ToggleMagnify"/>
    </keybind>
    <keybind key="W-Equal">
      <action name="ZoomIn"/>
    </keybind>
    <keybind key="W-Minus">
      <action name="ZoomOut"/>
    </keybind>
    <!-- Terminal -->
    <keybind key="W-T">
      <action name="Execute" command="alacritty"/>
    </keybind>
    <keybind key="W-F">
      <action name="ToggleFullscreen"/>
    </keybind>
    <!-- Rofi app launcher -->
    <keybind key="W-d ">
      <action name="Execute" command="sh -c 'killall rofi || ~/.config/rofi/launchers/launcher.sh'"/>
    </keybind>
    <!-- center -->
    <keybind key="W-c">
      <action name="AutoPlace" policy="center"/>
    </keybind>
    <!-- Wallpaper -->
    <keybind key="W-w">
      <action name="Execute" command="sh -c 'killall rofi || ~/.config/rofi/wallselect/wallselect.sh'"/>
    </keybind>
    <!-- Browser -->
    <keybind key="W-b">
      <action name="Execute" command="helium --incognito"/>
    </keybind>
    <!-- power menu -->
    <keybind key="W-Delete">
      <action name="Execute" command="sh -c 'killall rofi || ~/.config/rofi/powermenu/powermenu.sh'"/>
    </keybind>
    <!-- generate apps menu -->
    <keybind key="W-g">
      <action name="Execute" command="sh -c 'killall rofi || ~/.config/labwc/menu-generator.sh'"/>
    </keybind>
    <!-- screenshot tool -->
    <keybind key="Print">
      <action name="Execute" command="sh -c '$HOME/.config/mango/scripts/screenshot.sh'"/>
    </keybind>
    <!-- Close -->
    <keybind key="W-Q">
      <action name="Close"/>
    </keybind>
    <keybind key="W-p">
      <action name="Execute" command="sh -c 'killall rofi || ~/.config/rofi/rofi-tube/rofi-tube.sh --show-playlist'"/>
    </keybind>
    <keybind key="W-o">
      <action name="Execute" command="sh -c '$HOME/.local/bin/pongo-rgb.sh'"/>
    </keybind>
    <keybind key="W-i">
      <action name="Execute" command="sh -c '$HOME/.local/bin/pongo-rgb-bright.sh'"/>
    </keybind>
    <!-- Emoji Picker -->
    <keybind key="C-.">
      <action name="Execute" command="sh -c 'killall rofi || ~/.config/rofi/emoji-picker/emoji-picker.sh'"/>
    </keybind>
    <!-- Clipboard -->
    <keybind key="W-v">
      <action name="Execute" command="sh -c 'killall rofi || ~/.config/rofi/clipboard/clipboard.sh'"/>
    </keybind>
    <!-- Lock screen -->
    <keybind key="W-l">
      <action name="Execute" command="loginctl lock-session"/>
    </keybind>
    <!-- Reload labwc config -->
    <keybind key="W-r">
      <action name="Reconfigure"/>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
    <!-- Switch between workspaces -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1"/>
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2"/>
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3"/>
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4"/>
    </keybind>
    <!-- Move active window to workspace -->
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1"/>
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2"/>
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3"/>
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4"/>
    </keybind>
    <!-- Snap windows to halves/corners -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left"/>
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right"/>
    </keybind>
    <keybind key="W-Up">
      <action name="SnapToEdge" direction="up"/>
    </keybind>
    <keybind key="W-Down">
      <action name="SnapToEdge" direction="down"/>
    </keybind>
    <!-- You Change 5+, 5- to any number e.g. 10+, 10- for both volume and brightness -->
    <!-- Volume/microphone Control -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="sh -c '~/.config/waybar/scripts/volume_notif.sh +1'"/>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="sh -c '~/.config/waybar/scripts/volume_notif.sh -1'"/>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="sh -c '~/.config/waybar/scripts/volume_notif.sh --toggle-mute speaker'"/>
    </keybind>
    <keybind key="f7">
      <action name="Execute" command="sh -c '~/.config/waybar/scripts/volume_notif.sh --toggle-mute microphone'"/>
    </keybind>
    <!-- Brightness Control -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="sh -c '~/.config/waybar/scripts/brightness_ctrl.sh +5'"/>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="sh -c '~/.config/waybar/scripts/brightness_ctrl.sh -5'"/>
    </keybind>
  </keyboard>
  <!-- Mouse binding -->
  <!-- Added mouse bindings to kill rofi -->
  <mouse>
    <default/>
    <!-- Show apps menu on desktop right click -->
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu"/>
        <action name="Execute" command="pkill -x rofi"/>
      </mousebind>
      <mousebind button="Left" action="Press">
        <action name="Execute" command="pkill -x rofi"/>
        <action name="Unfocus"/>
      </mousebind>
    </context>
    <context name="Border">
      <mousebind button="Left" action="Press">
        <action name="Execute" command="pkill -x rofi"/>
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Execute" command="pkill -x rofi"/>
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Execute" command="pkill -x rofi"/>
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
  </mouse>
  <!-- Workspace settings -->
  <desktops number="4"/>
  <desktops>
    <popupTime>1000</popupTime>
    <names>
      <name>WS 1</name>
      <name>WS 2</name>
      <name>WS 3</name>
      <name>WS 4</name>
    </names>
  </desktops>
  <!-- Input settings -->
  <libinput>
    <!-- TOUCHPAD: laptop trackpads -->
    <device category="touchpad">
      <pointerSpeed>0</pointerSpeed>
      <!-- -1.0(slowest) to 1.0(fastest) -->
      <accelProfile>adaptive</accelProfile>
      <!-- adaptive, flat -->
      <naturalScroll>no</naturalScroll>
      <scrollFactor>0.3</scrollFactor>
      <scrollMethod>twoFinger</scrollMethod>
      <!-- twoFinger, edge -->
      <tap>yes</tap>
      <tapButtonMap>lrm</tapButtonMap>
      <tapAndDrag>yes</tapAndDrag>
      <dragLock>no</dragLock>
      <disableWhileTyping>yes</disableWhileTyping>
      <clickMethod>buttonAreas</clickMethod>
      <!-- buttonAreas, clickfinger, none -->
      <sendEventsMode>yes</sendEventsMode>
    </device>
    <!-- NON-TOUCH: physical/external mice -->
    <device category="non-touch">
      <pointerSpeed>0</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
      <naturalScroll>no</naturalScroll>
      <scrollFactor>1.0</scrollFactor>
      <leftHanded>no</leftHanded>
    </device>
  </libinput>
  <!--Magnifier -->
  <magnifier>
    <width>400</width>
    <height>400</height>
    <initScale>2</initScale>
    <increment>0.2</increment>
    <useFilter>true</useFilter>
  </magnifier>
  <!--Windows rule -->
  <windowRules>
    <windowRule title="Attention">
      <action name="ToggleAlwaysOnTop"/>
    </windowRule>
    <!-- Mpv window without titlebar only border -->
    <windowRule identifier="mpv">
      <action name="SetDecorations" decorations="border"/>
    </windowRule>
    <!-- Helium browser without titlebar -->
    <windowRule identifier="helium*">
      <action name="SetDecorations" decorations="yes"/>
    </windowRule>
    <!-- Force titlebar labwc on GTK4 / Libadwaita -->
    <windowRule identifier="org.gnome.TextEditor">
      <action name="SetDecorations" decorations="full" forceSSD="yes"/>
    </windowRule>
  </windowRules>
</labwc_config>
