#XfcePanelWindow{ border-radius: 15px; }

/*Battery*/
#xfce4-power-manager-plugin {
	color: #f9f9f9;
        margin: 4px;
        padding: 5px;
}
#xfce4-power-manager-plugin:hover {
        background: #c5c8c6; opacity: 0.9;
        color: #282828;
	border-color: #c5c8c6;
        border-bottom-left-radius: 4px;
        border-bottom-right-radius: 4px;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
        margin: 4px;
        padding: 5px;
}
#xfce4-power-manager-plugin image {
	-gtk-icon-theme: 'Reversal-black-dark';
        -gtk-icon-transform: scale(0.9) rotate(360deg); margin:-10px;
}

